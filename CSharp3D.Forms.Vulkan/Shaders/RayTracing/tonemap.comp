#version 460

// Exposure and tone mapping, then sRGB, into the image the swapchain is copied from.
//
// The curve is the ACES fit Unreal's filmic tonemapper is built on (its defaults are the
// ACES RRT+ODT with mild adjustments), so an exposed frame here lands where the game's does.

layout(local_size_x = 16, local_size_y = 16) in;

layout(set = 0, binding = 0, rgba32f) uniform readonly image2D hdr;
layout(set = 0, binding = 1, rgba8) uniform writeonly image2D ldr;

layout(set = 0, binding = 2, std430) buffer Exposure
{
    float adaptedLogLum;
    float exposure;
    float pad0, pad1;
};

// How the composed picture becomes bytes (TonemapMode in GpuTypes.cs).
const uint MODE_FILMIC = 0u;            // exposure, ACES, sRGB: Unreal's default
const uint MODE_DISPLAY = 1u;           // already screen values (GoldSrc, Quake II): clamp only
const uint MODE_LINEAR_EXPOSURE = 2u;   // linear x exposure, clamp, sRGB: Source's integer HDR

layout(push_constant) uniform Push
{
    uint mode;
    float fixedScale;   // MODE_LINEAR_EXPOSURE: the exposure; 0 = what the exposure pass adapted to
    float pad0, pad1;
} push;

// Stephen Hill's fit of the ACES RRT + sRGB ODT.
const mat3 ACES_INPUT = mat3(
    0.59719, 0.07600, 0.02840,
    0.35458, 0.90834, 0.13383,
    0.04823, 0.01566, 0.83777);

const mat3 ACES_OUTPUT = mat3(
     1.60475, -0.10208, -0.00327,
    -0.53108,  1.10813, -0.07276,
    -0.07367, -0.00605,  1.07602);

vec3 rrtAndOdt(vec3 v)
{
    vec3 a = v * (v + 0.0245786) - 0.000090537;
    vec3 b = v * (0.983729 * v + 0.4329510) + 0.238081;
    return a / b;
}

vec3 acesFilmic(vec3 color)
{
    color = ACES_INPUT * color;
    color = rrtAndOdt(color);
    color = ACES_OUTPUT * color;
    return clamp(color, 0.0, 1.0);
}

vec3 linearToSrgb(vec3 c)
{
    return mix(c * 12.92, 1.055 * pow(c, vec3(1.0 / 2.4)) - 0.055, step(0.0031308, c));
}

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(hdr);

    if (pixel.x >= size.x || pixel.y >= size.y)
        return;

    vec3 composed = imageLoad(hdr, pixel).rgb;

    if (push.mode == MODE_DISPLAY)
    {
        imageStore(ldr, pixel, vec4(clamp(composed, 0.0, 1.0), 1.0));
        return;
    }

    if (push.mode == MODE_LINEAR_EXPOSURE)
    {
        float scale = push.fixedScale > 0.0 ? push.fixedScale : exposure;
        imageStore(ldr, pixel, vec4(linearToSrgb(clamp(composed * scale, 0.0, 1.0)), 1.0));
        return;
    }

    vec3 hdrColor = composed * exposure;
    vec3 mapped = acesFilmic(hdrColor);

    imageStore(ldr, pixel, vec4(linearToSrgb(mapped), 1.0));
}
