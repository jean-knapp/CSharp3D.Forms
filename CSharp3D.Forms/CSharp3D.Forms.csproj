<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- A shared library: other projects still target .NET Framework 4.7.2, so it always builds
         both. XBLAH's Modding Tool uses net10.0-windows (net10-port-plan.md in modding-tool-dev3).
         net472 comes first, so the VS designer keeps the .NET Framework designer for this library. -->
    <TargetFrameworks>net472;net10.0-windows</TargetFrameworks>
    <RootNamespace>CSharp3D.Forms</RootNamespace>
    <AssemblyName>CSharp3D.Forms</AssemblyName>
    <OutputType>Library</OutputType>
    <StartupObject></StartupObject>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <UseWindowsForms>true</UseWindowsForms>
    <Platforms>AnyCPU</Platforms>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <!-- Items are listed explicitly, as in the legacy project: the same files compile and
         the same resources embed under the same names. -->
    <EnableDefaultItems>false</EnableDefaultItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <!-- net472 keeps the bin\<Configuration>\ folder its consumers have always used; net10.0-windows goes to bin\<Configuration>\net10.0-windows\. -->
    <AppendTargetFrameworkToOutputPath Condition="'$(TargetFramework)' == 'net472'">false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <!-- Windows-only, so the platform-compatibility analyzer (CA1416) has nothing to report.
         WFO1000 wants every public control property to declare its designer serialization; the
         defaults it would spell out are the ones net472 already applies (net10-port-plan.md). -->
    <NoWarn>$(NoWarn);CA1416;WFO1000</NoWarn>
  </PropertyGroup>

